{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DIM Creator",
  "version": "../package.json",
  "identifier": "com.dimcreator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "DIM Creator", "width": 1400, "height": 900, "minWidth": 540, "minHeight": 600 }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../LICENSE": "LICENSE",
      "licenses/archive-dependencies.txt": "licenses/archive-dependencies.txt"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
